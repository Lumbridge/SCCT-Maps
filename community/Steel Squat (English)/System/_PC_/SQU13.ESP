[SZoneTips2231]
sMessage_ATT[0]="Aquí tienes el sexto objetivo de misión: |Debes robar un disco de datos y llevarlo al punto de salida. Puedes elegir el camino que quieras."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips250]
sMessage_ATT[0]="Hay seis objetivos de misión disponibles. Debes completar al menos cuatro de ellos para cumplir tu misión."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips258]
sMessage_ATT[0]="Cinco de esos objetivos son consolas que debes neutralizar. El sexto es un disco que debes robar."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips267]
sMessage_ATT[0]="Hay muchas formas de pasar de un edificio a otro: un puente de cuerda, las alcantarillas, los pasillos..."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips275]
sMessage_ATT[0]="Aquí tienes el primer objetivo de misión: |La consola situada en la antigua tienda."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips283]
sMessage_ATT[0]="Éste es el segundo objetivo de misión: |La consola situada en las oficinas abandonadas. Ten cuidado, porque los mercenarios pueden defenderlo lanzando una granada desde el exterior."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips296]
sMessage_ATT[0]="Al hackear esta caja activas el cierre de las rejas de seguridad: así se protegen las consolas."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips305]
sMessage_ATT[0]="Aquí está el tercer objetivo de misión: |La consola situada en la sala."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips313]
sMessage_ATT[0]="Aquí tienes el cuarto objetivo de misión: |La consola situada en el laboratorio para preparar explosivos."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips321]
sMessage_ATT[0]="Éste es el quinto objetivo de misión: |La consola situada en la cocina del viejo restaurante."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips329]
sMessage_ATT[0]="Para salir al patio, rompe el cristal de la ventana con tu arma, y recuerda que por el hueco del cristal roto puede entrar o salir una granada."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

[SZoneTips338]
sMessage_ATT[0]="Para acceder al sexto objetivo de misión debes demoler las puertas. Hackea la grúa para abrirte camino."
sMessage_ATT[1]=""
sMessage_DEF[0]=""
sMessage_DEF[1]=""

