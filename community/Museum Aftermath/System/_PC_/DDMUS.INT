[SZoneTips1863]
sMessage_ATT[0]="You must achieve three of the five available objectives: two consoles to neutralize, two zones to sabotage or one disk to bring back."
sMessage_ATT[1]=""
sMessage_DEF[0]="You must achieve three of the five available objectives: two consoles to neutralize, two zones to sabotage or one disk to bring back."
sMessage_DEF[1]=""

[SZoneTips1866]
sMessage_ATT[0]="The red arrows indicate the places where you can put the stolen disk. End of presentation."
sMessage_ATT[1]=""
sMessage_DEF[0]="The red arrows indicate the places where you can put the stolen disk. End of presentation."
sMessage_DEF[1]=""

[SZoneTips1875]
sMessage_ATT[0]="The Museum has five zones: the CAFÉ, the CORRIDORS, the MONOLITH ROOM, the EXHIBITION ROOM and the STOREROOM."
sMessage_ATT[1]=""
sMessage_DEF[0]="The Museum has five zones: the CAFÉ, the CORRIDORS, the MONOLITH ROOM, the EXHIBITION ROOM and the STOREROOM."
sMessage_DEF[1]=""

[SZoneTips1878]
sMessage_ATT[0]="You are in the CAFÉ zone. It has two consoles to neutralize."
sMessage_ATT[1]=""
sMessage_DEF[0]="You are in the CAFÉ zone. It has two consoles to neutralize."
sMessage_DEF[1]=""

[SZoneTips1881]
sMessage_ATT[0]="You are in the CORRIDORS zone. The corridors link up all the other zones."
sMessage_ATT[1]=""
sMessage_DEF[0]="You are in the CORRIDORS zone. The corridors link up all the other zones."
sMessage_DEF[1]=""

[SZoneTips1884]
sMessage_ATT[0]="You are in the EXHIBITION ROOM. The mission objective is to plant a bomb there. The MONOLITH ROOM has a similar objective."
sMessage_ATT[1]=""
sMessage_DEF[0]="You are in the EXHIBITION ROOM. The mission objective is to plant a bomb there. The MONOLITH ROOM has a similar objective."
sMessage_DEF[1]=""

[SZoneTips1887]
sMessage_ATT[0]="This staircase takes you directly to the STOREROOM. You can also get there by going through the CORRIDORS."
sMessage_ATT[1]=""
sMessage_DEF[0]="This staircase takes you directly to the STOREROOM. You can also get there by going through the CORRIDORS."
sMessage_DEF[1]=""

[SZoneTips1891]
sMessage_ATT[0]="Take the disk in the STOREROOM to accomplish another mission objective. Watch out for the lasers! They block access to the disk."
sMessage_ATT[1]=""
sMessage_DEF[0]="Take the disk in the STOREROOM to accomplish another mission objective. Watch out for the lasers! They block access to the disk."
sMessage_DEF[1]=""

[SZoneTips1894]
sMessage_ATT[0]="You must return to the CAFÉ or the terrace to put the stolen disk there."
sMessage_ATT[1]=""
sMessage_DEF[0]="You must return to the CAFÉ or the terrace to put the stolen disk there."
sMessage_DEF[1]=""

