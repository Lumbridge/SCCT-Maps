[SMission366]
ObjectiveName="Unnamed mission"
Description="Find and keep the data disks to complete your mission."
DescriptionDEF="Prevent the intruders from getting their hands on the data disks to complete your mission."

[SMission380]
ObjectiveName="Unnamed mission"
Description="Complete 2 of the 6 mission objectives to destroy the ARGUS PMC data. GL & HF"
DescriptionDEF="Protect the strategic objectives and neutralize the intruders.GL & HF"

[SMission782]
ObjectiveName="Unnamed mission"
Description="Eliminate all of the members of the ARGUS PMC who are present.GL & HF"
DescriptionDEF="Eliminate all the intruders seeking to infiltrate the club.GL & HF"

