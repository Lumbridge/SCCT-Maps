[SMission285]
ObjectiveName="Unnamed mission"
Description="Pick up and keep the data disks to complete your mission."
DescriptionDEF="Prevent the intruders from getting their hands on the data disks to complete your mission."

[SMission4783]
ObjectiveName="Unnamed mission"
Description="Accomplish the 2 mission objectives to put a stop to the network hacking.GL & HF"
DescriptionDEF="Protect the objectives and neutralize the intruders.GL & HF"

[SMission9325]
ObjectiveName="Unnamed mission"
Description="Eliminate all of the members of the ARGUS PMC who are present."
DescriptionDEF="Eliminate all the intruders seeking to infiltrate the zone you defend."

[SMission9344]
ObjectiveName=""
Description="Hack into 1 of the 3 terminals or take hdd in the TRAIN MAINTENANCE ZONE."
DescriptionDEF="Terminal: CONTROL ROOM (access point to next zone)"

